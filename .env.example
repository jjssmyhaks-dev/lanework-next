# Neon PostgreSQL Database
DATABASE_URL="postgresql://username:password@your-neon-db-host/your-db?sslmode=require"

# JWT Authentication (required — generate with: openssl rand -hex 32)
JWT_SECRET="replace-with-a-random-64-char-hex-string"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-64-char-hex-string"

# Cloudflare Workers AI
CLOUDFLARE_AI_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_AI_API_KEY="your-cloudflare-ai-api-key"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
