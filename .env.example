# Lanework Environment Variables

# ============================================================
# REQUIRED — App will not start without these
# ============================================================

# Neon PostgreSQL Database (get yours: https://neon.tech)
DATABASE_URL="postgresql://username:***@your-neon-db-host/your-db?sslmode=require"

# JWT Authentication Secret (generate with: openssl rand -hex 32)
JWT_SECRET="replace-with-64-char-hex"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-64-char-hex"

# Application URL (for linking in emails, webhook callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================
# AI / Agent Intelligence
# ============================================================

# Cloudflare Workers AI
CLOUDFLARE_AI_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_AI_API_KEY="your-cloudflare-api-key"

# ============================================================
# MCP Integrations — Shipping & Delivery
# ============================================================

# Shiprocket (Indian carrier aggregator — Delhivery, BlueDart, DTDC, etc.)
# Get credentials: shiprocket.in → Settings → API
SHIPROCKET_EMAIL="your-shiprocket-email"
SHIPROCKET_PASSWORD="your-shiprocket-password"
SHIPROCKET_CHANNEL_ID=""          # Optional — multi-channel only

# FedEx International Shipping
# Get credentials: fedex.com → Developer Resource Center
FEDEX_API_KEY="your-fedex-api-key"
FEDEX_SECRET_KEY="your-fedex-secret-key"
FEDEX_ACCOUNT_NUMBER="your-fedex-account-number"

# DHL International Shipping
DHL_API_KEY="your-dhl-api-key"
DHL_ACCOUNT_NUMBER="your-dhl-account-number"

# ============================================================
# MCP Integrations — Accounting & Compliance
# ============================================================

# TallyPrime (Indian accounting system for MSMEs)
# Enable REST API: Open Tally → Ctrl+Alt+R
TALLY_REST_URL="http://localhost:9000"
TALLY_COMPANY="Your Company Name"

# GSTN E-Way Bill API
# Register: ewaybillgst.gov.in → API Registration
GSTN_BASE_URL="https://gstn.api.gov.in/ewb/api/v1"

# RTO / Parivahan (vehicle registration, driver license checks)
PARIVAHAN_API_KEY="your-parivahan-api-key"

# ============================================================
# MCP Integrations — Maps & Fleet
# ============================================================

# MapmyIndia (Indian maps — more accurate than Google for tier-2/3 cities)
# Get API key: mapmyindia.com → Dashboard → API Keys
MAPMYINDIA_LICENSE_KEY="your-mapmyindia-license-key"

# Fleet Telematics (LocoNav, FleetX, or generic provider)
FLEET_PROVIDER="loconav"           # Options: loconav, fleetx, custom
FLEET_API_SECRET="your-fleet-api-secret"

# ============================================================
# MCP Integrations — Payments
# ============================================================

# Razorpay (UPI, cards, net banking, COD reconciliation)
# Get keys: dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# ============================================================
# MCP Integrations — Messaging
# ============================================================

# WhatsApp Business API
# Get credentials: developers.facebook.com → My Apps → WhatsApp
WHATSAPP_PHONE_ID="your-whatsapp-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"

# Email (SMTP or Resend)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="Lanework <notifications@yourdomain.com>"

# ============================================================
# MCP Integrations — E-Commerce
# ============================================================

# Shopify
# Get token: Shopify Admin → Settings → Apps → Develop apps
SHOPIFY_STORE_URL="https://your-store.myshopify.com"
SHOPIFY_ACCESS_TOKEN="your-shopify-access-token"

# WooCommerce
WOO_STORE_URL="https://your-store.com"
WOO_CONSUMER_KEY="your-woo-consumer-key"
WOO_CONSUMER_SECRET="your-woo-consumer-secret"

# ============================================================
# MCP Integrations — Data & Sync
# ============================================================

# Google Sheets
GOOGLE_SHEETS_API_KEY="your-google-sheets-api-key"
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# ============================================================
# MCP Integrations — Warehouse & Operations
# ============================================================

# Warehouse Management System (WMS)
WMS_API_URL="https://your-wms-api.com"
WMS_API_KEY="your-wms-api-key"

# SAP Business One (ERP)
SAP_SERVICE_LAYER_URL="https://your-sap-server:50000/b1s/v1"
SAP_COMPANY_DB="your-sap-company-db"
