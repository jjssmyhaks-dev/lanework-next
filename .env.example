# ══════════════════════════════════════════════════════════════════════════════
# Lanework — Environment Variables
# Copy this file to .env.local and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/lanework?sslmode=require

# ── Auth & Security ──────────────────────────────────────────────────────────
JWT_SECRET=your-64-char-random-secret-here
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI Providers (at least one required for AI chat) ────────────────────────
# Vercel AI SDK — uses OpenAI by default
OPENAI_API_KEY=sk-...
# Anthropic Claude (optional fallback)
ANTHROPIC_API_KEY=sk-ant-...
# AI model selector: "openai" (default) or "claude"
AI_MODEL=openai
# Cloudflare Workers AI (used by some agents)
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_KEY=

# ── Voice Transcription ──────────────────────────────────────────────────────
DEEPGRAM_API_KEY=your-deepgram-api-key

# ── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=Lanework <notifications@lanework.in>

# ── SMS & WhatsApp ───────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=lanework-whatsapp-verify

# ── Payments (Razorpay — India) ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=

# ── Shipping & Logistics ─────────────────────────────────────────────────────
# Shiprocket (Indian shipping aggregator)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=

# FedEx (international shipping)
FEDEX_API_KEY=
FEDEX_API_SECRET=
FEDEX_WEBHOOK_AUTH=

# ── Maps & Geolocation ───────────────────────────────────────────────────────
MAPMYINDIA_LICENSE_KEY=

# ── Fleet Tracking ───────────────────────────────────────────────────────────
FLEET_API_KEY=
FLEET_API_SECRET=

# ── E-Commerce Platforms ─────────────────────────────────────────────────────
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
WOO_STORE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# ── ERP & Accounting ─────────────────────────────────────────────────────────
TALLY_REST_URL=http://localhost:9000
SAP_SERVICE_LAYER_URL=
SAP_COMPANY_DB=

# ── Google Services ──────────────────────────────────────────────────────────
GOOGLE_SHEETS_API_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SITE_VERIFICATION=

# ── GST / Compliance (India) ─────────────────────────────────────────────────
GSTN_API_KEY=
GSTN_API_SECRET=

# ── Warehouse Management ─────────────────────────────────────────────────────
WMS_API_URL=

# ── Monitoring & Logging ─────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ── Cron / Background Jobs ───────────────────────────────────────────────────
CRON_SECRET=your-cron-secret

# ── Webhook Security ─────────────────────────────────────────────────────────
WEBHOOK_ALLOWED_IPS=comma-separated-ip-list

# ── Feature Flags ────────────────────────────────────────────────────────────
# Enable/disable features per plan tier
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_ENABLE_AI_CHAT=true
NEXT_PUBLIC_ENABLE_FLEET_TRACKING=true
