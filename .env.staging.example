# Staging Environment — copy to .env.staging.local
# Uses same Neon database as production but with staging prefixes

DATABASE_URL="postgresql://staging_user:***@ep-staging-host.neon.tech/lanework_staging?sslmode=require"
JWT_SECRET="staging-jwt-secret-at-least-32-characters-long"
NEXTAUTH_SECRET="staging-nextauth-secret-at-least-32-characters-long"
NEXT_PUBLIC_APP_URL="https://staging.lanework.in"
CLOUDFLARE_ACCOUNT_ID="your-staging-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-staging-cloudflare-api-token"
RESEND_API_KEY="re_staging_key_here"
RAZORPAY_KEY_ID="rzp_test_staging_key"
RAZORPAY_KEY_SECRET="staging_razorpay_secret"
SENTRY_DSN="https://staging-sentry-dsn"
